# Pureweight Gold Exchange — environment
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
# Used for canonical URLs, Open Graph, the sitemap and robots.txt.
# Must be the production origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.pureweight.example

# ---------------------------------------------------------------------------
# VALUATION ENQUIRY DELIVERY  —  REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Without this, POST /api/valuation returns 503 in production and tells the
# visitor to telephone instead. That is deliberate: a form that reports success
# while writing to a log nobody reads loses real enquiries silently.
#
# Point this at anything that accepts a JSON POST — Zapier, Make, n8n, a CRM
# intake endpoint, or your own API. See the payload shape in
# src/app/api/valuation/route.ts.
VALUATION_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <secret>` so the receiver can verify
# the request actually came from this site.
VALUATION_WEBHOOK_SECRET=
