{
  "name": "pureweight-gold-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "Pureweight Gold Exchange — immersive WebGL brand experience.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:geometry": "node --experimental-strip-types scripts/check-geometry.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:geometry && npm run check:contrast && npm run check:budget && npm run check:rates",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:budget": "node --experimental-strip-types scripts/check-budget.mjs",
    "make:craquelure": "node scripts/make-craquelure.mjs",
    "check:rates": "node --experimental-strip-types scripts/check-rates.mjs",
    "check:scene-contrast": "node scripts/check-section-scene-contrast.mjs"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
