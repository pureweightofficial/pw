{
  "name": "pureweight-gold-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "Pureweight Gold Exchange — immersive WebGL brand experience.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:geometry": "node --experimental-strip-types scripts/check-geometry.mjs",
    "check:content": "node scripts/check-content.mjs",
    "verify": "npm run check:secrets && npm run check:content && npm run typecheck && npm run lint && npm run check:contrast && npm run check:budget",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:budget": "node --experimental-strip-types scripts/check-budget.mjs",
    "make:craquelure": "node scripts/make-craquelure.mjs",
    "check:scene-contrast": "node scripts/check-section-scene-contrast.mjs",
    "check:sticky": "node scripts/check-sticky.mjs",
    "check:canonical": "node scripts/check-canonical.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "shot:local": "node scripts/shot-local.mjs",
    "shot:live": "node scripts/shot-live.mjs",
    "shot:world": "node scripts/shot-world.mjs",
    "shot:keeper": "node scripts/shot-keeper.mjs",
    "check:3d-payload": "node scripts/check-3d-payload.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:keeper-a11y": "node scripts/check-keeper-a11y.mjs",
    "verify:built": "npm run check:a11y && npm run check:keeper-a11y && npm run check:prose && npm run check:weight",
    "shot:sweep": "node scripts/shot-sweep.mjs",
    "shot:scene": "node scripts/shot-scene.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "check:voids": "node scripts/check-voids.mjs",
    "check:keeper-door": "node scripts/check-keeper-door.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:weight": "node scripts/check-weight.mjs"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20",
    "marked": "^18.0.7",
    "motion": "^13.1.0",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
